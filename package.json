{
  "name": "omp-purge",
  "version": "0.3.0",
  "description": "omp (oh-my-pi) extension: switch a session between the stock system prompt, a trimmed variant, and a bundled or custom persona prompt - for prompt-engineering experiments. Also works in pi.",
  "type": "module",
  "license": "MIT",
  "author": "ZiChuanLan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvxunz/omp-purge.git"
  },
  "homepage": "https://github.com/kvxunz/omp-purge#readme",
  "bugs": {
    "url": "https://github.com/kvxunz/omp-purge/issues"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "omp-extension",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "system-prompt",
    "prompt-engineering",
    "prompt-evaluation"
  ],
  "files": [
    "extensions",
    "test",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/omp-purge.test.mjs && node test/omp-purge-env-source.test.mjs && node test/omp-purge-env-legacy.test.mjs && node test/omp-purge-host.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0 <2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/omp-purge.ts"
    ]
  },
  "contributors": [
    "kvxunz"
  ]
}
